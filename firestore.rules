rules_version = '2';
// Mangia Mangia — friends-only recipe box, no accounts.
// Anyone with the link can read and write. Documents are kept well-formed (a recipe must have a title,
// a rating must be 1–5, a name must be short). Firebase itself caps every document at 1 MB.
// Paste this in Firebase → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /recipes/{id} {
      allow read, delete: if true;
      allow create, update: if request.resource.data.title is string
                            && request.resource.data.title.size() > 0
                            && request.resource.data.title.size() <= 120;
      match /comments/{cid} { allow read, write: if true; }
    }
    match /photos/{id}    { allow read, write: if true; }
    match /ratings/{id}   { allow read, delete: if true;
                            allow create, update: if request.resource.data.stars is number
                                                  && request.resource.data.stars >= 1
                                                  && request.resource.data.stars <= 5; }
    match /favorites/{id} { allow read, write: if true; }
    match /users/{id}     { allow read, delete: if true;
                            allow create, update: if request.resource.data.name is string
                                                  && request.resource.data.name.size() <= 40; }
    match /battles/{id}     { allow read, write: if true; }
    match /battlevotes/{id} { allow read, write: if true; }
  }
}
